# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=

# Flask API, called from the server only (the browser never sees this address)
BACKEND_URL=http://localhost:5000

# Guest login: a fallback when Google sign-in is unavailable.
# Read on the server at request time, so changing it needs a restart, not a rebuild.
# Unset: on for local development and Vercel previews, off in production.
GUEST_LOGIN_ENABLED=true
# Must equal GUEST_PROXY_SECRET on the Flask side. Lets Flask trust the visitor IP
# this server forwards, so per-IP guest limits apply to the visitor and not to this server.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_PROXY_SECRET=
