FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/labeans

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_HOURS=24

# OpenRouter (Phase 3)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Orders and insights (Phase 6-7, all optional)
DEFAULT_CURRENCY=USD
LOW_STOCK_KG=20
REORDER_THRESHOLD_DAYS=10

# Guest login: a fallback when Google sign-in is unavailable (Phase: guest access)
# Defaults to true in development and false in production; set it explicitly for previews.
GUEST_LOGIN_ENABLED=true
GUEST_JWT_TTL_HOURS=4
GUEST_PURGE_AFTER_HOURS=24
GUEST_RATE_LIMIT=5 per minute
GUEST_MAX_PER_IP_PER_DAY=10
GUEST_AI_LIMIT=3 per minute;30 per day
# Guest owners can only order from seeded demo suppliers (google_sub starting with the prefix)
GUEST_ORDER_DEMO_SUPPLIERS_ONLY=true
DEMO_SUPPLIER_SUB_PREFIX=seed_
# Shared with the frontend. Lets Flask trust the visitor IP forwarded by the Next.js server.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GUEST_PROXY_SECRET=
